FROM node:22 AS build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build
FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
#CMD ["nginx", "-g", "daemon off;"]
# THIS CMD IS USED TO STATER THE SERVER BUT CAN BE OMITTED AS NGINX WILL START BY DEFAULT WHEN THE CONTAINER IS RUN.